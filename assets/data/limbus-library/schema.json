{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raise Don Quixote Limbus Content Catalogue",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "type": "string" },
    "description": { "type": "string" },
    "sourceStatus": { "type": "object" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
          "type": { "enum": ["character", "identity", "ego", "skill", "passive", "enemy", "status", "stage", "asset", "voiceLine"] },
          "name": { "type": "string", "minLength": 1 },
          "characterId": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "assetPaths": { "type": "object", "additionalProperties": { "type": "string" } },
          "skillIds": { "type": "array", "items": { "type": "string" } },
          "input": { "type": "string" },
          "moveId": { "type": "string" },
          "animationKey": { "type": "string" },
          "voiceLineKey": { "type": "string" },
          "source": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
